{
  "name": "phglabs-reel",
  "version": "1.0.0",
  "description": "Instagram Reel for phglabs.in, rendered with TwinStudio local AI tools",
  "scripts": {
    "script": "node 01-script.mjs",
    "voice": "node 02-voice.mjs af_heart",
    "images": "node 03-images.mjs",
    "capture": "node 04-capture.mjs",
    "timeline": "node 05-timeline.mjs",
    "render": "node 06-render.mjs",
    "audio": "node 07-audio.mjs",
    "mux": "C:/hari/code/twin-souls-studio/tools/ffmpeg/ffmpeg.exe -y -i build/video.mp4 -i build/mix.wav -map 0:v -map 1:a -c:v copy -c:a aac -b:a 192k -shortest -movflags +faststart out/phglabs-reel.mp4",
    "build": "npm run timeline && npm run render && npm run audio && npm run mux"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "kokoro-js": "^1.2.1"
  },
  "private": true
}